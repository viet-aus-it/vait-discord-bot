{
  "name": "@viet-aus-it/discord-bot",
  "version": "2.12.1",
  "description": "Chat bot for VAIT Discord Server",
  "homepage": "https://github.com/viet-aus-it/vait-discord-bot#readme",
  "bugs": {
    "url": "https://github.com/viet-aus-it/vait-discord-bot"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viet-aus-it/vait-discord-bot.git"
  },
  "main": "build/index.js",
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc",
    "build": "tsdown",
    "build:typecheck": "pnpm typecheck && pnpm build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:fix:unsafe": "oxlint --fix-dangerously",
    "format": "oxfmt --write .",
    "ci": "oxlint && oxfmt --check .",
    "test": "dotenvx run -- vitest",
    "test:silent": "dotenvx run -- vitest --silent",
    "drizzle:generate": "dotenvx run -- drizzle-kit generate",
    "drizzle:introspect": "dotenvx run -- drizzle-kit introspect",
    "drizzle:migrate": "dotenvx run -- drizzle-kit migrate",
    "drizzle:push": "dotenvx run -- drizzle-kit push",
    "drizzle:studio": "dotenvx run -- drizzle-kit studio",
    "deploy:command": "dotenvx run -- oxnode --import ./bin/telemetry.ts scripts/deploy-guild-commands.ts",
    "delete:command": "dotenvx run -- oxnode --import ./bin/telemetry.ts scripts/delete-guild-commands.ts",
    "delete:command-global": "dotenvx run -- oxnode --import ./bin/telemetry.ts scripts/delete-global-commands.ts",
    "start:only": "dotenvx run -- oxnode --import ./bin/telemetry.ts --watch ./bin/main.ts",
    "start": "pnpm drizzle:migrate && pnpm start:only",
    "build:referrals": "dotenvx run -- oxnode --import ./bin/telemetry.ts ./bin/build-referral-list.ts"
  },
  "dependencies": {
    "@discordjs/rest": "2.0.0",
    "@dotenvx/dotenvx": "^2.32.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@oxc-node/cli": "^0.1.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "cowsay": "^1.6.0",
    "date-fns": "^4.4.0",
    "discord-api-types": "^0.38.56",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "node-html-parser": "^9.0.4",
    "oxide.ts": "^1.1.0",
    "parse-duration": "^2.1.9",
    "pg": "^8.23.1",
    "winston": "^3.19.0",
    "wretch": "^3.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^26.6.4",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "drizzle-kit": "^1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "rolldown": "1.0.0-beta.29",
    "rollup-plugin-copy": "^3.5.0",
    "testcontainers": "^12.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "vitest-mock-extended": "^5.1.1"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@12.9.1"
}
